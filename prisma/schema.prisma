// TechConnect site — data model.
//
// SQLite everywhere, locally and on the server alike — deliberately the SAME
// engine in both places, so there is no dialect gap to produce "worked on my
// machine" bugs. Locally it is prisma/dev.db; in Docker it is a file on a
// named volume (see docker-compose.yml).
//
// Fine for this site's shape: a handful of editors writing occasionally, and
// Next.js serving from a single process, so there is no write contention.
// If it ever outgrows that, switching to PostgreSQL means changing `provider`
// here and pointing DATABASE_URL at a server — the models need no changes,
// because enums are avoided on purpose and the string fields (role / type /
// status) are validated in app code with Zod instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("MODERATOR") // "ADMIN" | "MODERATOR"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The "Новости" nav tab is a real multi-page gazette: an ordered list of
// GazettePages, each a freeform canvas of blocks. Pages that share the same
// issueNumber belong to one dated issue (there's no separate Issue table —
// page-in-issue index / total-in-issue are derived from this grouping).
model GazettePage {
  id          String   @id @default(cuid())
  issueNumber Int      @default(1)
  issueDate   DateTime @default(now())
  order       Int      @default(0) // global order: issue grouping order AND page-within-issue order
  width       Int      @default(1240) // design-space canvas size in px; blocks are
  height      Int      @default(1754) // positioned/sized in these same px units
  // NOTE: default MUST stay true — a false default would un-publish every
  // existing page the moment `prisma db push` runs. New pages are created as
  // drafts by passing published:false explicitly in createGazettePage().
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks NewspaperBlock[]

  @@index([order])
}

model NewspaperBlock {
  id     String @id @default(cuid())
  pageId String
  page   GazettePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  x      Int // px position within the canvas (top-left origin)
  y      Int
  width  Int
  height Int
  zIndex Int @default(0)

  tone String @default("light") // "light" | "dark" | "flame" — block background
  kind String @default("content") // "content" | "headline" | "banner" | "gallery"

  number String @default("") // story index badge, e.g. "#1" (content kind, optional)
  kicker String @default("") // gray category label next to the title (content kind)

  title     String @default("")
  contentMd String @default("") // rich text body (markdown)

  imageUrl   String?
  imageFit   String  @default("cover") // "cover" | "contain"
  imageScale Float   @default(1) // extra zoom on top of the fit, 1 = no zoom
  imagePosX  Float   @default(50) // focal point %, used when cropped by "cover"
  imagePosY  Float   @default(50)
  imageW     Int? // intrinsic px, captured at upload — drives crop-pan limits
  imageH     Int?
  imageLayout String @default("top") // "top" | "bottom" | "left" | "right" | "full"
  imageSpan   Int    @default(55) // % of the block given to the photo
  imageAlt    String @default("")

  images String @default("[]") // JSON array of {url,w?,h?,alt?} — gallery kind only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  type            String   @default("MEETUP") // MEETUP | HACKATHON | FORUM | OTHER
  description     String   @default("")
  location        String?
  date            DateTime
  status          String   @default("UPCOMING") // PAST | ONGOING | UPCOMING
  coverImage      String?
  registrationUrl String?
  order           Int      @default(0)
  isFinal         Boolean  @default(false) // конец дорожки: линия обрывается на этом событии
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([order])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String   @default("")
  help        String   @default("") // чем помог объединению
  url         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model PortfolioItem {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  coverImage    String?
  participants  Int?
  partnersCount Int?
  resultText    String?
  date          DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([order])
}

model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Application {
  id        String   @id @default(cuid())
  name      String
  contact   String   @default("") // telegram / email / phone
  role      String   @default("") // желаемое направление
  message   String   @default("")
  status    String   @default("NEW") // NEW | REVIEWED | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  @@index([status])
}
