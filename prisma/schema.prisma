// TechConnect site — data model.
// SQLite for local dev; switch `provider` to "postgresql" for production (VPS).
// NOTE: enums are avoided on purpose so the same schema works on SQLite and Postgres.
// Constrained string fields (role / type / status) are validated in app code (Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("MODERATOR") // "ADMIN" | "MODERATOR"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  news News[]
}

model News {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  coverImage  String?
  contentMd   String    @default("")
  tags        String    @default("") // comma-separated
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  @@index([published, publishedAt])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  type            String   @default("MEETUP") // MEETUP | HACKATHON | FORUM | OTHER
  description     String   @default("")
  location        String?
  date            DateTime
  status          String   @default("UPCOMING") // PAST | ONGOING | UPCOMING
  coverImage      String?
  registrationUrl String?
  order           Int      @default(0)
  isFinal         Boolean  @default(false) // конец дорожки: линия обрывается на этом событии
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([order])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String   @default("")
  help        String   @default("") // чем помог объединению
  url         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model PortfolioItem {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  coverImage    String?
  participants  Int?
  partnersCount Int?
  resultText    String?
  date          DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([order])
}

model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Application {
  id        String   @id @default(cuid())
  name      String
  contact   String   @default("") // telegram / email / phone
  role      String   @default("") // желаемое направление
  message   String   @default("")
  status    String   @default("NEW") // NEW | REVIEWED | ACCEPTED | REJECTED
  createdAt DateTime @default(now())

  @@index([status])
}
