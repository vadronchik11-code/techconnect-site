# Long random string. Generate: openssl rand -base64 32
AUTH_SECRET="change-me"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@techconnect.ru"
SEED_ADMIN_PASSWORD="change-me"
